# Copy this file to .env next to compose.yaml and fill in the required values.

# Required. Generate a deployment-specific token of at least 24 characters, for example: openssl rand -hex 32
DOCKSIGHT_API_TOKEN=
# Optional named operators, each with a distinct token:
# DOCKSIGHT_API_TOKENS={"alice":"generated-token-1","bob":"generated-token-2"}

# Required. Numeric group that owns /var/run/docker.sock, for example: stat -c %g /var/run/docker.sock
DOCKSIGHT_DOCKER_GID=

# Browser access. The web port is published on loopback only. Keep the origin in sync with the port.
DOCKSIGHT_HTTP_PORT=8080
DOCKSIGHT_BROWSER_ORIGIN=http://127.0.0.1:8080
# Loopback HTTP exception. Use true with an HTTPS origin behind your own TLS proxy.
DOCKSIGHT_COOKIE_SECURE=false

# Model provider. host.docker.internal resolves to the Docker host from the backend container.
DOCKSIGHT_PROVIDER=ollama
DOCKSIGHT_MODEL=qwen3.5:9b
DOCKSIGHT_MODEL_BASE_URL=http://host.docker.internal:11434
DOCKSIGHT_OLLAMA_CONTEXT_LENGTH=16384
# Additional Ollama endpoint for the model selector:
# DOCKSIGHT_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Cloud providers are opt-in. They receive sanitized Docker evidence selected during diagnosis.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DOCKSIGHT_PROVIDER=openai
# DOCKSIGHT_MODEL=your-model-id

# Optional limits and allowlists. See the configuration reference for every setting.
# DOCKSIGHT_ENV_ALLOWLIST=["APP_ENV"]
# DOCKSIGHT_BROWSER_SESSION_TTL=28800
# DOCKSIGHT_BROWSER_SESSION_IDLE_TTL=3600
