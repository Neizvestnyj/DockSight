DOCKSIGHT_API_TOKEN=replace-with-a-random-token-at-least-24-characters
DOCKSIGHT_PROVIDER=ollama
DOCKSIGHT_MODEL=qwen3.5:9b
DOCKSIGHT_MODEL_BASE_URL=http://127.0.0.1:11434
DOCKSIGHT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
DOCKSIGHT_OLLAMA_CONTEXT_LENGTH=16384
# DOCKSIGHT_MODEL_API_KEY=
