DOCKSIGHT_API_TOKEN=replace-with-a-random-token-at-least-24-characters
# Optional named operators, each with a distinct token:
# DOCKSIGHT_API_TOKENS={"alice":"replace-with-token-1","bob":"replace-with-token-2"}
DOCKSIGHT_PROVIDER=ollama
DOCKSIGHT_MODEL=qwen3.5:9b
DOCKSIGHT_MODEL_BASE_URL=http://127.0.0.1:11434
DOCKSIGHT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# Start development with --host 127.0.0.1 --port 5173. Match Vite's printed origin.
# Its /api proxy sets changeOrigin=true and changes the backend Host header.
DOCKSIGHT_BROWSER_ORIGIN=http://127.0.0.1:5173
# Explicit loopback HTTP development exception. Use true behind production HTTPS.
DOCKSIGHT_COOKIE_SECURE=false
# Start production preview with --host 127.0.0.1 --port 4173. Replace BROWSER_ORIGIN and restart:
# DOCKSIGHT_BROWSER_ORIGIN=http://127.0.0.1:4173
DOCKSIGHT_STATE_BACKEND=sqlite
DOCKSIGHT_STATE_PATH=.docksight/state.sqlite3
# DOCKSIGHT_BROWSER_SESSION_TTL=28800
# DOCKSIGHT_BROWSER_SESSION_IDLE_TTL=3600
# Explicit temporary development mode loses all history and action protection on restart:
# DOCKSIGHT_STATE_BACKEND=memory
DOCKSIGHT_OLLAMA_CONTEXT_LENGTH=16384
# DOCKSIGHT_MODEL_API_KEY=
# Secondary providers are configured on the server; the browser receives only model IDs.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DOCKSIGHT_OPENAI_BASE_URL=https://api.openai.com/v1/
# DOCKSIGHT_ANTHROPIC_BASE_URL=https://api.anthropic.com/
# DOCKSIGHT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DOCKSIGHT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# DOCKSIGHT_COMPATIBLE_BASE_URL=http://127.0.0.1:8080/v1/
# DOCKSIGHT_COMPATIBLE_API_KEY=
# DOCKSIGHT_COMPATIBLE_STRUCTURED_OUTPUT=native
# DOCKSIGHT_GEMINI_STRUCTURED_OUTPUT=native
# DOCKSIGHT_PROVIDER_FALLBACK_MODELS={"openai":["your-model-alias"],"compatible":["your-local-model"]}
# DOCKSIGHT_HOSTS_FILE=examples/hosts.yaml
