        <mxCell id="reconciliation-note" value="Offline reconciliation: exact target + revision + configured actor + native OS operator + reason + acknowledgement.&#10;Fresh Docker observation; atomic audit + invalidate preparations + clear block. Old outcome stays indeterminate." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
