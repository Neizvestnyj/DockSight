          <mxGeometry x="20" y="225" width="520" height="35" as="geometry" />
        </mxCell>
        <mxCell id="work-label" value="ACCEPTED WORK AND OBSERVATION" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;strokeColor=none;fillColor=none;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="225" width="510" height="35" as="geometry" />
        </mxCell>
        <mxCell id="initialize" value="Acquire lock -&gt; open + integrity/schema check&#10;Packaged forward migrations" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="20" y="285" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="recover" value="One recovery transaction before readiness&#10;Running turns -&gt; interrupted; release scope/reservation&#10;Claimed -&gt; failed; dispatching -&gt; indeterminate + block&#10;Revoke obsolete sessions + one bounded cleanup batch" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="20" y="425" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="Readiness only after committed recovery&#10;Never resume generation automatically&#10;Storage failure closes writes; no memory fallback" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="20" y="615" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="initialize-recover" value="" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#52627A;" edge="1" parent="1" source="initialize" target="recover">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="recover-ready" value="" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#52627A;" edge="1" parent="1" source="recover" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="accept" value="Atomic receipt + turn + actor/host scope&#10;Workspace revision + maximum snapshot reservation&#10;Retained worker registration before 202" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="670" y="285" width="510" height="100" as="geometry" />
        </mxCell>
        <mxCell id="supervisor" value="TurnRunner owns the diagnostic worker&#10;Progress and terminal answers commit before notification&#10;Bounded plain model context; fresh runtime evidence" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="670" y="435" width="510" height="110" as="geometry" />
        </mxCell>
        <mxCell id="observers" value="Up to four coalesced snapshot observers&#10;Disconnect/logout detaches; explicit Stop cancels&#10;Read or reattach by turn ID without resubmitting" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="670" y="595" width="510" height="110" as="geometry" />
        </mxCell>
        <mxCell id="accept-worker" value="" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#52627A;" edge="1" parent="1" source="accept" target="supervisor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="worker-observers" value="" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#52627A;" edge="1" parent="1" source="supervisor" target="observers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="offline-label" value="STOPPED-BACKEND MAINTENANCE - SAME EXCLUSIVE LOCK, SEPARATE OPENING" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;strokeColor=none;fillColor=none;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="765" width="1160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="status: inspect disposable immutable copy&#10;backup: copy source + journal BEFORE source SQLite opens&#10;migrate: explicit forward upgrade only" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="20" y="835" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="reconcile" value="reconcile: configured Docker reads; no mutation&#10;Exact target/revision + actor + native OS operator&#10;Reason + acknowledge unknown outcome&#10;Atomic audit + clear guard; old result stays unknown" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="670" y="835" width="510" height="130" as="geometry" />
        </mxCell>
        <mxCell id="limits-note" value="Maintenance never constructs normal model/turn services or runs server recovery.&#10;Do not delete state to unblock. No automatic mutation retry or distributed exactly-once claim." style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
