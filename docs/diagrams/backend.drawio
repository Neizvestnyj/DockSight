        <mxCell id="note" value="The same key recovers the retained execution/outcome, including after SQLite restart.&#10;An indeterminate exact-target block survives restart and archive deletion." style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#17202A;strokeWidth=2;sketch=1;fillStyle=solid;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
