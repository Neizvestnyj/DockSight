{
  "name": "docksight-frontend",
  "private": true,
  "version": "0.8.3",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:browser:persistence": "playwright test --config playwright.persistence.config.ts",
    "check:types": "tsc -b",
    "check:lint": "eslint . --max-warnings 0",
    "check:format": "prettier --check .",
    "check:architecture": "node scripts/check-layout.mjs && depcruise src --config .dependency-cruiser.cjs --output-type err",
    "check:unused": "knip --no-progress",
    "check:styles": "stylelint \"src/**/*.css\" --max-warnings 0",
    "check": "npm run check:types && npm run check:lint && npm run check:format && npm run check:architecture && npm run check:unused && npm run check:styles"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.13.0",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
